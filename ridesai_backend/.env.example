# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL — primary production & local default when configured)
# Primary connection string (recommended for Docker, Render, Railway, AWS RDS, etc.)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/ridesai_db
DB_CONN_MAX_AGE=600
DB_SSL_REQUIRE=False

# Alternative discrete PostgreSQL variables (used if DATABASE_URL is omitted)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=ridesai_db
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

# Explicit opt-in fallback to SQLite for offline local testing only
USE_SQLITE=False

# Frontend/backend URLs
SITE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Polar sandbox (use the matching sandbox product IDs and webhook secret)
POLAR_API_URL=https://sandbox-api.polar.sh
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# Development only: set True to simulate checkout locally without charging a card.
# The backend rejects this mode whenever DJANGO_DEBUG=False.
POLAR_MOCK_MODE=False

# Email OTP delivery (set your sender and Gmail App Password before testing inbox delivery)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-sender@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=RidesAI <your-sender@gmail.com>

# AI Agent (optional until configured)
DEFAULT_MESSAGE_LIMIT=1000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
